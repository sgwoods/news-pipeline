# Copy to .env and fill in. .env is gitignored, never commit it.
# Only needed if config.yaml llm.backend is claude_api.
# Leave UNSET for the default claude_code backend, or the claude CLI will bill this key.
ANTHROPIC_API_KEY=
# Shared secret for the email Apps Script (create with ./np email key)
EMAIL_SCRIPT_KEY=
# Gmail app password (16 characters, Google Account -> Security -> App passwords); read-only IMAP use
GMAIL_APP_PASSWORD=
